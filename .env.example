# Application Settings
APP_NAME="Smart Grocery Inventory & Expiry Tracker"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Security & Authentication
SECRET_KEY="supersecret_smart_grocery_key_replace_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is SQLite for out-of-the-box operation:
DATABASE_URL="sqlite:///./smart_grocery.db"

# To use MySQL instead, uncomment the line below and update credentials:
# DATABASE_URL="mysql+pymysql://root:password@localhost:3306/smart_grocery"
